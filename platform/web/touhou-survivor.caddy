handle /TouhouSurvivor {
    redir * /TouhouSurvivor/ 308
}

handle_path /TouhouSurvivor/* {
    root * /srv/touhou-survivor/public
    header {
        Cross-Origin-Opener-Policy same-origin
        Cross-Origin-Embedder-Policy require-corp
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data: blob:; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
    }
    @immutable path /releases/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    @entry not path /releases/*
    header @entry Cache-Control no-cache
    encode zstd gzip
    file_server {
        precompressed gzip
    }
}
