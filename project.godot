; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Touhou-Wuxia-Survivor"
config/version="alpha-0.0.2"
run/main_scene="res://src/ui/menu/MainMenu.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://assets/branding/icon.png"

[autoload]

PerformanceDiagnostics="*res://src/diagnostics/performance/PerformanceDiagnosticsHost.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="TouhouWuxiaSurvivor"

