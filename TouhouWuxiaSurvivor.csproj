<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TouhouWuxiaSurvivor</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove=".godot/**/*.cs" />
    <Compile Remove="tools/**/*.cs" />
    <Compile Include="tools/internal_assets/InternalActorStripAssetBuilder.cs" />
    <Compile Include="tools/internal_assets/InternalAssetBuildContext.cs" />
    <Compile Include="tools/internal_assets/InternalAssetManifestCompiler.cs" />
    <Compile Include="tools/internal_assets/InternalPreviewAssetBuilder.cs" />
    <Compile Include="tools/internal_assets/InternalImageTransformer.cs" />
    <Compile Include="tools/internal_assets/InternalBinaryAssetBuilder.cs" />
    <Compile Include="tools/internal_assets/InternalPortraitAssetBuilder.cs" />
    <Compile Include="tools/internal_assets/InternalSceneAssetBuilder.cs" />
    <Compile Include="tools/internal_assets/InternalSourceHashWriter.cs" />
  </ItemGroup>
</Project>
