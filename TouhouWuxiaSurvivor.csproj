<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition="'$(GodotWebBuild)' == 'true'">net9.0</TargetFramework>
    <OutputType Condition="'$(GodotWebBuild)' == 'true'">Exe</OutputType>
    <DefineConstants Condition="'$(GodotWebBuild)' == 'true'">$(DefineConstants);SHARED_WEB_BUILD</DefineConstants>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Rebirth</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="game/**/*.cs" />
  </ItemGroup>
</Project>
